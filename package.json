{
  "name": "careergoals",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "tsx server/src/migrate.ts",
    "dev": "concurrently -n api,web -c magenta,cyan \"yarn dev:server\" \"yarn dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "tsc -b && vite build",
    "prestart": "tsx server/src/migrate.ts",
    "start": "cross-env NODE_ENV=production tsx server/src/index.ts",
    "migrate": "tsx server/src/migrate.ts",
    "db:backup": "tsx server/src/backup.ts",
    "db:restore": "tsx server/src/restore.ts",
    "seed": "tsx server/src/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.90.2",
    "bson": "^6.10.4",
    "cors": "^2.8.5",
    "date-holidays": "^3.36.1",
    "dayjs": "^1.11.23",
    "dotenv": "^17.2.3",
    "echarts": "^6.1.0",
    "express": "^5.1.0",
    "interactjs": "1.10.27",
    "mongoose": "^8.19.1",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-calendar-timeline": "0.30.0-beta.19",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "sonner": "^2.0.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@types/babel__core": "^7.20.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}
