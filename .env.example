# ---- Server ----
NODE_ENV=development
PORT=4000

# Local MongoDB (Docker or a native install)
MONGODB_URI=mongodb://127.0.0.1:27019/careergoals

# MongoDB Atlas (replace user, password, cluster host)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/careergoals?retryWrites=true&w=majority

# Allowed browser origin for CORS (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# ---- Client (must be prefixed with VITE_) ----
# Leave unset in dev: the Vite proxy forwards /api to the Express port above.
# VITE_API_URL=http://localhost:4000/api
